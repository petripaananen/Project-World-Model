# PWM Environment Configuration
# Copy this file to .env and fill in your values

# ── Gemini API Access ──────────────────────────────────────
# Option 1: Google AI Studio key (simplest)
GOOGLE_API_KEY=

# Option 2: Google Cloud / Vertex AI
GCP_PROJECT_ID=
GCP_LOCATION=us-central1

# ── GitHub Ingestion ────────────────────────────────────────
PWM_GITHUB_OWNER=
PWM_GITHUB_REPO=
GITHUB_PERSONAL_ACCESS_TOKEN=  # Required for github-mcp-server

# ── Linear Ingestion ───────────────────────────────────────
PWM_LINEAR_TEAM_ID=
LINEAR_API_KEY=                # Required for linear-mcp-server

# ── World Labs Marble API (3DGS garden generation) ─────────
# Sign up at: https://platform.worldlabs.ai
# Purchase API credits (separate from Marble web app credits).
# Cost: $1 USD = 1,250 credits. Minimum purchase: $5 (6,250 credits).
# Garden generation cost: 1,500 credits per world (marble-1.1 model).
WORLD_LABS_API_KEY=            # Generate key at platform.worldlabs.ai → API Keys
 
# ── JEPA Model Serving Endpoints (Local Docker or GCE GPU host) ─
# Connect to containerized model serving microservices
PWM_GRAPH_JEPA_ENDPOINT_URL=http://localhost:8005
PWM_JEPA_WM_ENDPOINT_URL=http://localhost:8006
PWM_POINT_JEPA_ENDPOINT_URL=http://localhost:8007

